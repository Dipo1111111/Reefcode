#!/usr/bin/env bash
# REEF launcher. Runs the vendored CLI with the pinned pi core.
# Everything user-visible comes from the vendored tree; this script only finds it.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../../.." && pwd)"
cli="$root/vendor/pi/packages/coding-agent/dist/cli.js"

if [ ! -f "$cli" ]; then
  echo "reef: the build is missing at $cli" >&2
  echo "reef: run 'npm run build' in $root/vendor/pi" >&2
  exit 70
fi

node_bin="${REEF_NODE:-node}"
exec "$node_bin" "$cli" "$@"
