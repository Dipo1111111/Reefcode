diff --git a/packages/coding-agent/src/extensions/reef-stats/index.ts b/packages/coding-agent/src/extensions/reef-stats/index.ts
new file mode 100644
index 0000000..1cc4eb6
--- /dev/null
+++ b/packages/coding-agent/src/extensions/reef-stats/index.ts
@@ -0,0 +1,189 @@
+/**
+ * Measurement, in the harness rather than in a spreadsheet.
+ *
+ * Every assistant message ends with a usage record. This extension appends one `reef-request`
+ * entry per model call: tokens, cache split, cost, the declared tool count, and an estimate of the
+ * prompt that was sent. `/cost` reads them back.
+ *
+ * The point is that the numbers in `docs/12-evals.md` can be checked from a normal session:
+ * base prompt, cache reuse, and cost per turn are visible without a separate harness.
+ */
+
+import type { ExtensionAPI, ExtensionFactory } from "../../core/extensions/types.ts";
+
+/** Session custom-entry type holding one model call's usage. */
+export const REEF_REQUEST_ENTRY_TYPE = "reef-request";
+
+export interface ReefRequestEntry {
+	/** Estimated tokens of the system prompt plus the declared tool schemas. */
+	promptTokens: number;
+	declaredTools: string[];
+	input: number;
+	output: number;
+	cacheRead: number;
+	cacheWrite: number;
+	reasoning: number;
+	cost: number;
+	model: string;
+	provider: string;
+	at: number;
+}
+
+function estimateTokens(text: string): number {
+	return Math.round(text.length / 3.6);
+}
+
+function messageUsage(message: unknown): ReefRequestEntry | undefined {
+	const candidate = message as
+		| {
+				role?: string;
+				usage?: { input?: number; output?: number; cacheRead?: number; cacheWrite?: number; reasoning?: number; cost?: { total?: number } };
+				model?: string;
+				provider?: string;
+		  }
+		| undefined;
+	if (!candidate || candidate.role !== "assistant" || !candidate.usage) return undefined;
+	const usage = candidate.usage;
+	return {
+		promptTokens: 0,
+		declaredTools: [],
+		input: usage.input ?? 0,
+		output: usage.output ?? 0,
+		cacheRead: usage.cacheRead ?? 0,
+		cacheWrite: usage.cacheWrite ?? 0,
+		reasoning: usage.reasoning ?? 0,
+		cost: usage.cost?.total ?? 0,
+		model: candidate.model ?? "unknown",
+		provider: candidate.provider ?? "unknown",
+		at: Date.now(),
+	};
+}
+
+function formatCount(value: number): string {
+	if (value < 1000) return String(value);
+	if (value < 1_000_000) return `${(value / 1000).toFixed(1)}k`;
+	return `${(value / 1_000_000).toFixed(2)}M`;
+}
+
+function formatUsd(value: number): string {
+	if (value === 0) return "$0";
+	if (value < 0.01) return `$${value.toFixed(4)}`;
+	return `$${value.toFixed(2)}`;
+}
+
+export function createReefStatsExtension(): ExtensionFactory {
+	return (pi) => {
+		// Read lazily: the runtime is not initialised while the extension is loading.
+		let declared: string[] = [];
+		const readDeclared = () => {
+			try {
+				declared = pi.getActiveTools();
+			} catch {
+				// Loading order: keep the last known set.
+			}
+			return declared;
+		};
+
+		pi.on("tool_call", async () => {
+			readDeclared();
+			return undefined;
+		});
+
+		pi.on("message_end", async (event, ctx) => {
+			const entry = messageUsage(event.message);
+			if (!entry) return undefined;
+			const promptChars = (ctx.getSystemPrompt?.() ?? "").length;
+			entry.declaredTools = readDeclared();
+			// The tool schemas are not in the prompt string; they are priced by the request. Use the
+			// declared names as a lower bound and let the provider's own numbers carry the rest.
+			entry.promptTokens = estimateTokens(ctx.getSystemPrompt?.() ?? "");
+			void promptChars;
+			pi.appendEntry(REEF_REQUEST_ENTRY_TYPE, entry);
+			return undefined;
+		});
+
+		pi.registerCommand("trace", {
+			description: "The last requests: tokens per section, cache verdict, violations",
+			handler: async (args: string, ctx) => {
+				if (typeof ctx.getRequestAudits !== "function") {
+					ctx.ui?.notify?.("Request auditing is not available in this context.");
+					return;
+				}
+				const limit = Number.parseInt(args.trim(), 10) || 5;
+				const audits = ctx.getRequestAudits().slice(-limit);
+				if (audits.length === 0) {
+					ctx.ui?.notify?.("No requests yet.");
+					return;
+				}
+				const lines: string[] = [];
+				for (const audit of audits) {
+					const head = `#${audit.request}  ${audit.tokens} tok  cache ${audit.cacheablePrefixTokens} tok  ${
+						audit.appendOnly ? "append-only" : `BREAK (${audit.breakReason})`
+					}`;
+					lines.push(head);
+					const sections = Object.entries(audit.sectionTokens).sort((a, b) => b[1] - a[1]);
+					lines.push(`   ${sections.map(([name, tokens]) => `${name} ${tokens}`).join(" · ")}`);
+					lines.push(`   tools: ${audit.tools.join(", ")}`);
+					for (const truncated of audit.truncated) {
+						lines.push(`   truncated ${truncated.name}: dropped ${truncated.dropped} bytes`);
+					}
+					for (const violation of audit.violations) lines.push(`   ! ${violation}`);
+				}
+				const budget = ctx.getSectionBudget();
+				if (budget) lines.push("", `total prompt: ${budget.tokens} tokens`);
+				ctx.ui?.notify?.(lines.join("\n"));
+			},
+		});
+
+		pi.registerCommand("cost", {
+			description: "Tokens, cache reuse, and spend for this session",
+			handler: async (_args: string, ctx) => {
+				const entries = readEntries(ctx.sessionManager.getBranch?.() ?? []);
+				if (entries.length === 0) {
+					ctx.ui?.notify?.("No model calls recorded yet.");
+					return;
+				}
+				const sum = entries.reduce(
+					(acc, entry) => ({
+						input: acc.input + entry.input,
+						output: acc.output + entry.output,
+						cacheRead: acc.cacheRead + entry.cacheRead,
+						cacheWrite: acc.cacheWrite + entry.cacheWrite,
+						cost: acc.cost + entry.cost,
+					}),
+					{ input: 0, output: 0, cacheRead: 0, cacheWrite: 0, cost: 0 },
+				);
+				const promptTotal = sum.input + sum.cacheRead + sum.cacheWrite;
+				const reuse = promptTotal === 0 ? 0 : (sum.cacheRead / promptTotal) * 100;
+				const last = entries[entries.length - 1];
+				const lines = [
+					`Requests:      ${entries.length}`,
+					`Input:         ${formatCount(sum.input)}`,
+					`Output:        ${formatCount(sum.output)}`,
+					`Cache read:    ${formatCount(sum.cacheRead)}`,
+					`Cache write:   ${formatCount(sum.cacheWrite)}`,
+					`Cache reuse:   ${reuse.toFixed(1)}%`,
+					`Cost:          ${formatUsd(sum.cost)}`,
+					"",
+					`Declared tools: ${last.declaredTools.length ? last.declaredTools.join(", ") : "—"}`,
+					`Prompt:        ~${formatCount(last.promptTokens)} tokens (system prompt only)`,
+					`Model:         ${last.provider}/${last.model}`,
+				];
+				ctx.ui?.notify?.(lines.join("\n"));
+			},
+		});
+	};
+}
+
+function readEntries(branch: readonly unknown[]): ReefRequestEntry[] {
+	const entries: ReefRequestEntry[] = [];
+	for (const item of branch) {
+		const entry = item as { type?: string; customType?: string; data?: unknown };
+		if (entry.type !== "custom" || entry.customType !== REEF_REQUEST_ENTRY_TYPE) continue;
+		const data = entry.data as ReefRequestEntry | undefined;
+		if (data && typeof data.at === "number") entries.push(data);
+	}
+	return entries;
+}
+
+export default createReefStatsExtension();
diff --git a/packages/coding-agent/src/extensions/safety/index.ts b/packages/coding-agent/src/extensions/safety/index.ts
new file mode 100644
index 0000000..a5af2a6
--- /dev/null
+++ b/packages/coding-agent/src/extensions/safety/index.ts
@@ -0,0 +1,142 @@
+/**
+ * The safety floor as an extension: one `tool_call` handler between the model and every tool.
+ *
+ * It runs before the call executes, for direct calls and for calls a script makes (`ctx.executeTool`
+ * goes through the same pipeline), so a script cannot reach a tool the direct path would refuse.
+ *
+ * A block is a tool result the model reads, not a crash: `policy_block` with the rule id and the
+ * reason, so the next attempt can be a better one.
+ */
+
+import type { ExtensionAPI, ExtensionFactory } from "../../core/extensions/types.ts";
+import { SETTINGS_DEFAULTS } from "../../core/settings-defaults.ts";
+import { type LoadedPolicy, loadPolicy } from "./policy.ts";
+import { checkRules } from "./rules.ts";
+import { type Context, decideWithPolicy, isTier, type Tier } from "./tiers.ts";
+
+export interface SafetyOptions {
+	tier?: Tier;
+	headless?: boolean;
+}
+
+function readTier(pi: ExtensionAPI): Tier {
+	const fromEnv = process.env.REEF_TIER;
+	if (isTier(fromEnv)) return fromEnv;
+	if (process.env.REEF_READ_ONLY === "1" || process.env.REEF_READ_ONLY === "true") return "none";
+	const configured = (pi.getSettings() as { safety?: { tier?: unknown } }).safety?.tier;
+	return isTier(configured) ? configured : SETTINGS_DEFAULTS.safety.tier;
+}
+
+function readSkipApprovals(pi: ExtensionAPI): boolean {
+	if (process.env.REEF_SKIP_APPROVALS === "1") return true;
+	const configured = (pi.getSettings() as { safety?: { skipApprovals?: unknown } }).safety?.skipApprovals;
+	return configured === true;
+}
+
+export function createSafetyExtension(options: SafetyOptions = {}): ExtensionFactory {
+	return (pi) => {
+		// A rule that fails its own examples is inert. Recording it once beats trusting it.
+		let problems = checkRules();
+		let policy: LoadedPolicy | undefined;
+		const load = (cwd: string) => {
+			policy = loadPolicy({ cwd });
+			problems = [...checkRules(), ...policy.problems];
+			return policy;
+		};
+		const current = (cwd: string): LoadedPolicy => policy ?? load(cwd);
+
+		pi.registerCommand("permissions", {
+			description: "Show the rules that apply here, or reload them",
+			handler: async (args: string, ctx) => {
+				if (args.trim() === "reload") load(ctx.cwd);
+				const loaded = current(ctx.cwd);
+				const lines = [`Rules: ${loaded.rules.length} (${loaded.sources.length} file${loaded.sources.length === 1 ? "" : "s"})`];
+				for (const source of loaded.sources) lines.push(`  ${source}`);
+				const bySource = new Map<string, number>();
+				for (const rule of loaded.rules) bySource.set(rule.source, (bySource.get(rule.source) ?? 0) + 1);
+				for (const [source, count] of bySource) lines.push(`  ${source}: ${count}`);
+				if (loaded.problems.length > 0) {
+					lines.push("", "Problems:");
+					for (const problem of loaded.problems) lines.push(`  ! ${problem}`);
+				}
+				ctx.ui?.notify?.(lines.join("\n"));
+			},
+		});
+
+		pi.registerCommand("safety", {
+			description: "Show the current autonomy tier and what it allows",
+			handler: async (_args: string, ctx) => {
+				const tier = options.tier ?? readTier(pi);
+				const loaded = current(ctx.cwd);
+				const lines = [
+					`Tier: ${tier}`,
+					"",
+					"none    reads only",
+					"low     writes inside the project, asks before shell commands",
+					"medium  runs shell commands except the built-in block rules",
+					"high    also allows remote writes",
+					"",
+					"Blocked at every tier: deleting root or home, force-push, history rewrite,",
+					"reading credential files, piping a download into a shell.",
+					`Approvals skipped: ${readSkipApprovals(pi) ? "yes" : "no"}`,
+					`Headless: ${ctx.hasUI ? "no" : "yes (an ask becomes a deny)"}`,
+				];
+				lines.push(`Policy files: ${loaded.sources.length === 0 ? "none" : loaded.sources.join(", ")}`);
+				if (problems.length > 0) lines.push("", ...problems.map((problem) => `rule problem: ${problem}`));
+				ctx.ui?.notify?.(lines.join("\n"));
+			},
+		});
+
+		/** Commands the user approved in this session, so the same ask is not shown twice. */
+		const approved = new Set<string>();
+
+		pi.on("tool_call", async (event, ctx) => {
+			const tier = options.tier ?? readTier(pi);
+			const context: Context = {
+				cwd: ctx.cwd,
+				tier,
+				headless: options.headless ?? !ctx.hasUI,
+				skipApprovals: readSkipApprovals(pi),
+			};
+			const call = {
+				tool: event.toolName,
+				input: (event.input ?? {}) as Record<string, unknown>,
+				nested: event.parentToolCallId !== undefined,
+			};
+			const verdict = decideWithPolicy(call, context, current(ctx.cwd).rules);
+			if (verdict.decision === "allow") return;
+			if (verdict.decision === "ask" && !context.headless && ctx.ui) {
+				// Interactive: ask, once per distinct command per session. A batch of identical asks is
+				// noise, not diligence.
+				const key = `${call.tool}\u0000${summarize(call)}`;
+				if (!approved.has(key)) {
+					const ok = await ctx.ui.confirm(
+						`Allow this ${call.tool} call?`,
+						`${summarize(call)}\n\n${verdict.reason}`,
+					);
+					if (!ok) {
+						return { block: true, reason: `policy_denied: ${verdict.reason}` };
+					}
+					approved.add(key);
+				}
+				return;
+			}
+			const label = verdict.ruleId ? `policy_block (${verdict.ruleId})` : "policy_block";
+			return {
+				block: true,
+				reason: `${label}: ${verdict.reason}`,
+			};
+		});
+	};
+}
+
+/** A short, quotable form of the call for the approval dialog and the block message. */
+function summarize(call: { tool: string; input: Record<string, unknown> }): string {
+	if (typeof call.input.command === "string") return call.input.command;
+	const path = call.input.path ?? call.input.file_path;
+	if (typeof path === "string") return path;
+	const entries = Object.entries(call.input).slice(0, 3);
+	return entries.map(([key, value]) => `${key}=${String(value).slice(0, 60)}`).join(" ");
+}
+
+export default createSafetyExtension();
