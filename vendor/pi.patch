+const valid = (overrides: Record<string, unknown> = {}) => ({
+	version: 1,
+	rules: [
+		{
+			id: "no-install",
+			decision: "block",
+			reason: "Use npm ci.",
+			match: { prefix: ["npm", "install"] },
+			tests: { match: ["npm install", "npm install left-pad"], noMatch: ["npm ci"] },
+			...overrides,
+		},
+	],
+});
