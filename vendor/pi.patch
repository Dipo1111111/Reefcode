index 0000000..eb50290
--- /dev/null
+++ b/packages/coding-agent/src/extensions/safety/shell.ts
@@ -0,0 +1,155 @@
+/**
+ * A small POSIX-ish shell lexer, for deciding what a command *is* before it runs.
+ *
+ * It is deliberately not a shell parser. It understands quotes, escapes, `&&`, `||`, `;`, `|`,
+ * and redirections, which is enough to split a command line into simple segments and read their
+ * tokens. Anything it cannot parse returns `undefined`, and the policy treats that as "no match":
+ * never guess, fall back to the tier default.
+ */
+
+export interface ShellSegment {
+	/** Tokens of one simple command, quotes removed. */
+	tokens: string[];
+	/** Operators that preceded this segment (`&&`, `||`, `;`, `|`). */
+	precededBy?: string;
+	/** Redirections found in this segment, as `>file`, `>>file`, `<file`. */
+	redirections: string[];
+}
+
+const OPERATORS = ["&&", "||", ";;", ";", "|"];
+
+/** Split a command line into simple segments. `undefined` when the line cannot be read. */
+export function parseShell(command: string): ShellSegment[] | undefined {
+	const segments: ShellSegment[] = [];
+	let tokens: string[] = [];
+	let redirections: string[] = [];
+	let current = "";
+	let hasCurrent = false;
+	let quote: '"' | "'" | undefined;
+	let pendingOperator: string | undefined;
+
+	const pushToken = () => {
+		if (hasCurrent) {
+			tokens.push(current);
+			current = "";
+			hasCurrent = false;
+		}
+	};
+	const pushSegment = () => {
+		pushToken();
+		if (tokens.length > 0) {
+			segments.push({ tokens, redirections, ...(pendingOperator ? { precededBy: pendingOperator } : {}) });
+			pendingOperator = undefined;
+		}
+		tokens = [];
+		redirections = [];
+	};
+
+	for (let i = 0; i < command.length; i++) {
+		const char = command[i] as string;
+		if (quote) {
+			if (char === "\\" && quote === '"') {
+				i++;
+				current += command[i] ?? "";
+				hasCurrent = true;
+				continue;
+			}
+			if (char === quote) {
+				quote = undefined;
+				hasCurrent = true;
+				continue;
+			}
+			current += char;
+			hasCurrent = true;
+			continue;
+		}
+		if (char === '"' || char === "'") {
+			quote = char;
+			hasCurrent = true;
+			continue;
+		}
+		if (char === "\\") {
+			i++;
+			current += command[i] ?? "";
+			hasCurrent = true;
+			continue;
+		}
+		if (char === "\n") {
+			pushSegment();
+			continue;
+		}
+		if (char === " " || char === "\t") {
+			pushToken();
+			continue;
+		}
+		if (char === ">" || char === "<") {
+			pushToken();
+			let op = char;
+			if (command[i + 1] === ">" || command[i + 1] === "&") {
+				op += command[i + 1];
+				i++;
+			}
+			let target = "";
+			while (i + 1 < command.length && /[^\s;&|]/.test(command[i + 1] as string)) {
+				i++;
+				target += command[i];
+			}
+			redirections.push(`${op}${target}`);
+			continue;
+		}
+		const two = command.slice(i, i + 2);
+		if (OPERATORS.includes(two)) {
+			pushSegment();
+			pendingOperator = two;
+			i++;
+			continue;
+		}
+		if (OPERATORS.includes(char)) {
+			pushSegment();
+			pendingOperator = char;
+			continue;
+		}
+		if (char === "`" || char === "$" || char === "(" || char === ")") {
+			// Substitutions are not modelled. A caller that needs them must not allow the segment.
+			return undefined;
+		}
+		current += char;
+		hasCurrent = true;
+	}
+	if (quote) return undefined;
+	pushSegment();
+	return segments;
+}
+
+/**
+ * Unwrap a command that only runs another command: `bash -c "..."`, `sh -c ...`, `env X=1 cmd`,
+ * `time cmd`, `nohup cmd`. Returns the inner command text when the wrapper is understood.
+ */
+export function unwrap(tokens: string[]): string | undefined {
+	const [head, ...rest] = tokens;
+	if (!head) return undefined;
+	if (["bash", "sh", "zsh", "dash"].includes(head)) {
+		const index = rest.findIndex((token) => token === "-c" || token === "-lc" || token === "-cl");
+		if (index === -1) return undefined;
+		return rest.slice(index + 1).join(" ");
+	}
+	if (head === "sudo" || head === "command" || head === "time" || head === "nohup" || head === "exec") {
+		const index = rest.findIndex((token) => !token.startsWith("-"));
+		return index === -1 ? undefined : rest.slice(index).join(" ");
+	}
+	if (head === "env") {
+		const index = rest.findIndex((token) => !token.includes("="));
+		return index === -1 ? undefined : rest.slice(index).join(" ");
+	}
+	return undefined;
+}
+
+/** Every unwrapping level, so `sudo bash -c "rm -rf /"` can be matched at the bottom. */
+export function expand(tokens: string[], depth = 0): string[][] {
+	if (depth > 4) return [tokens];
+	const inner = unwrap(tokens);
+	if (!inner) return [tokens];
+	const parsed = parseShell(inner);
+	if (!parsed) return [tokens];
+	return [tokens, ...parsed.flatMap((segment) => expand(segment.tokens, depth + 1))];
+}
diff --git a/packages/coding-agent/src/extensions/safety/tiers.ts b/packages/coding-agent/src/extensions/safety/tiers.ts
new file mode 100644
index 0000000..f76905c
--- /dev/null
+++ b/packages/coding-agent/src/extensions/safety/tiers.ts
@@ -0,0 +1,211 @@
+/**
+ * The safety floor: tier defaults, the built-in rules, and one function that decides.
+ *
+ * The floor is deliberately small. It exists so a fresh clone with no config cannot run
+ * `rm -rf /`, cannot read a private key into a transcript, and cannot push over someone's
+ * history. It asks before anything public or remote. Everything it cannot classify falls back
+ * to the tier default, and in a headless run an `ask` is a `block` — never a silent yes.
+ */
+
+import { type PolicyRule, resolveCommand } from "./policy.ts";
+import {
+	BUILTIN_RULES,
+	type BuiltinRule,
+	type Decision,
+	FILTER_PREFIXES,
+	matchesPrefix,
+	parseSegments,
+	READ_ONLY_PREFIXES,
+	ruleMatches,
+} from "./rules.ts";
+
+export type Tier = "none" | "low" | "medium" | "high";
+
+export const TIERS: readonly Tier[] = ["none", "low", "medium", "high"];
+
+export function isTier(value: unknown): value is Tier {
+	return typeof value === "string" && (TIERS as readonly string[]).includes(value);
+}
+
+export interface Call {
+	tool: string;
+	/** Parsed arguments, already validated against the tool's schema. */
+	input: Record<string, unknown>;
+	/** Set when a script made this call. */
+	nested: boolean;
+}
+
+export interface Verdict {
+	decision: Decision;
+	reason: string;
+	/** The rule that decided, when a rule did. */
+	ruleId?: string;
+	/** Short label for the UI: `read-only`, `write inside the repo`, `remote write`, … */
+	scopes: string[];
+}
+
+export interface Context {
+	cwd: string;
+	tier: Tier;
+	/** No human to ask. `ask` becomes `block`. */
+	headless: boolean;
+	/** Skip `ask` decisions (--yes). Never skips `block`. */
+	skipApprovals: boolean;
+}
+
+const READ_TOOLS = new Set(["read", "grep", "find", "ls", "glob", "search"]);
+const WRITE_TOOLS = new Set(["write", "edit", "multiedit", "patch"]);
+
+/** Tools that only change state through other tools, so the calls themselves are allowed. */
+const TRANSPARENT_TOOLS = new Set(["script", "wait_for_script", "task", "task_output", "task_stop", "tool_search"]);
+
+/** Whether a path is inside `cwd`. Symlinks are not resolved here; the post-check reports them. */
+export function insideCwd(cwd: string, path: string): boolean {
+	if (!path || path === ".") return true;
+	const normalized = path.startsWith("/") ? path : `${cwd.replace(/\/$/, "")}/${path}`;
+	const base = cwd.replace(/\/$/, "");
+	const parts = normalized.split("/");
+	const resolved: string[] = [];
+	for (const part of parts) {
+		if (part === "" || part === ".") continue;
+		if (part === "..") {
+			resolved.pop();
+			continue;
+		}
+		resolved.push(part);
+	}
+	return `/${resolved.join("/")}`.startsWith(`${base}/`) || `/${resolved.join("/")}` === base;
+}
+
+/** Whether every segment of a command is read-only (read commands plus neutral filters). */
+export function isReadOnlyCommand(command: string): boolean {
+	const segments = parseSegments(command);
+	if (!segments || segments.length === 0) return false;
+	return segments.every(
+		(tokens) =>
+			READ_ONLY_PREFIXES.some((prefix) => matchesPrefix(tokens, prefix)) ||
+			FILTER_PREFIXES.some((prefix) => matchesPrefix(tokens, prefix)),
+	);
+}
+
+function matchRule(command: string, rules: readonly BuiltinRule[]): BuiltinRule | undefined {
+	// Ask and block rules may match extracted inner segments, so the whole line is fair game.
+	for (const rule of rules) {
+		if (!rule.match.prefix && !rule.match.anyToken && !rule.match.regex) continue;
+		if (ruleMatches(rule, command)) return rule;
+	}
+	return undefined;
+}
+
+/** The tier default for a call no rule claimed. */
+function tierDefault(call: Call, context: Context): Verdict {
+	const { tier } = context;
+	const readOnly = typeof call.input.command === "string" ? isReadOnlyCommand(call.input.command) : false;
+
+	if (READ_TOOLS.has(call.tool)) {
+		return { decision: "allow", reason: "Reading.", scopes: ["read"] };
+	}
+	if (TRANSPARENT_TOOLS.has(call.tool)) {
+		return { decision: "allow", reason: "Calls it makes are checked one by one.", scopes: ["delegates"] };
+	}
+	if (WRITE_TOOLS.has(call.tool)) {
+		const path = String(call.input.path ?? call.input.file_path ?? "");
+		const inside = insideCwd(context.cwd, path);
+		if (tier === "none") {
+			return { decision: "ask", reason: "The `none` tier does not write.", scopes: ["write"] };
+		}
+		if (!inside) {
+			return { decision: "ask", reason: "That path is outside the project.", scopes: ["write", "outside-repo"] };
+		}
+		return { decision: "allow", reason: "Writing inside the project.", scopes: ["write"] };
+	}
+	if (call.tool === "bash") {
+		const command = String(call.input.command ?? "");
+		if (readOnly) return { decision: "allow", reason: "Read-only command.", scopes: ["read-only"] };
+		switch (tier) {
+			case "none":
+				return { decision: "ask", reason: "The `none` tier does not run commands.", scopes: ["shell"] };
+			case "low":
+				return { decision: "ask", reason: "The `low` tier asks before commands that change anything.", scopes: ["shell"] };
+			case "medium":
+			case "high":
+				return { decision: "allow", reason: "Shell command at the current tier.", scopes: ["shell"] };
+		}
+	}
+	// Unknown tool: allowed at medium and above, asked below, never silently at `none`.
+	if (tier === "none" || tier === "low") {
+		return { decision: "ask", reason: `The \`${tier}\` tier asks before \`${call.tool}\`.`, scopes: [call.tool] };
+	}
+	return { decision: "allow", reason: "Allowed at the current tier.", scopes: [call.tool] };
+}
+
+/** Decide one tool call. */
+export function decide(call: Call, context: Context, rules: readonly BuiltinRule[] = BUILTIN_RULES): Verdict {
+	const command = typeof call.input.command === "string" ? call.input.command : undefined;
+	const verdict = command
+		? (() => {
+				const rule = matchRule(command, rules);
+				return rule
+					? { decision: rule.decision, reason: rule.reason, ruleId: rule.id, scopes: [rule.id.replace(/^builtin\//, "")] }
+					: tierDefault(call, context);
+			})()
+		: tierDefault(call, context);
+
+	// Belt and braces: a secret path is a secret path whatever the tool.
+	const pathText = [call.input.path, call.input.file_path, call.input.command]
+		.filter((value): value is string => typeof value === "string")
+		.join(" ");
+	if (verdict.decision !== "block" && /\B\.env(\.[\w-]+)?\b|\bid_(rsa|ed25519)\b|\b\.ssh\/|\bcredentials\.json\b|\B\.pem\b/.test(pathText)) {
+		const rule = rules.find((candidate) => candidate.id === "builtin/secret-paths");
+		return { decision: "block", reason: rule?.reason ?? "That path holds credentials.", ruleId: "builtin/secret-paths", scopes: ["secret"] };
+	}
+
+	return enforce(context, verdict);
+}
+
+/**
+ * Turn an `ask` that nobody can answer into a deny. `skipApprovals` denies rather than allows: a
+ * flag that means "do not ask me" must never mean "do whatever you like".
+ */
+export function enforce(context: Context, verdict: Verdict): Verdict {
+	if (verdict.decision !== "ask") return verdict;
+	if (!context.headless && !context.skipApprovals) return verdict;
+	return {
+		decision: "block",
+		reason: context.headless
+			? `${verdict.reason} No human is here to approve it, so it was denied.`
+			: `${verdict.reason} Approvals were skipped, so it was denied.`,
+		ruleId: verdict.ruleId,
+		scopes: verdict.scopes,
+	};
+}
+
+/**
+ * Decide with the project's permissions files in front of the builtin floor.
+ *
+ * A policy rule wins over the tier default because it is more specific; the builtin floor is still
+ * applied to the result, because a `block` there is not overridable.
+ */
+export function decideWithPolicy(
+	call: Call,
+	context: Context,
+	policy: readonly PolicyRule[],
+	builtin: readonly BuiltinRule[] = BUILTIN_RULES,
+): Verdict & { source?: string } {
+	const command = typeof call.input.command === "string" ? call.input.command : undefined;
+	if (command) {
+		const resolution = resolveCommand(command, policy);
