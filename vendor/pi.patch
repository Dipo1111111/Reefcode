--- /dev/null
+++ b/packages/coding-agent/src/extensions/safety/tiers.ts
@@ -0,0 +1,211 @@
+/**
+ * The safety floor: tier defaults, the built-in rules, and one function that decides.
+ *
+ * The floor is deliberately small. It exists so a fresh clone with no config cannot run
+ * `rm -rf /`, cannot read a private key into a transcript, and cannot push over someone's
+ * history. It asks before anything public or remote. Everything it cannot classify falls back
+ * to the tier default, and in a headless run an `ask` is a `block` — never a silent yes.
+ */
+
+import { type PolicyRule, resolveCommand } from "./policy.ts";
+import {
+	BUILTIN_RULES,
+	type BuiltinRule,
+	type Decision,
+	FILTER_PREFIXES,
+	matchesPrefix,
+	parseSegments,
+	READ_ONLY_PREFIXES,
+	ruleMatches,
+} from "./rules.ts";
+
+export type Tier = "none" | "low" | "medium" | "high";
+
+export const TIERS: readonly Tier[] = ["none", "low", "medium", "high"];
+
+export function isTier(value: unknown): value is Tier {
+	return typeof value === "string" && (TIERS as readonly string[]).includes(value);
+}
+
+export interface Call {
+	tool: string;
+	/** Parsed arguments, already validated against the tool's schema. */
+	input: Record<string, unknown>;
+	/** Set when a script made this call. */
+	nested: boolean;
+}
+
+export interface Verdict {
+	decision: Decision;
+	reason: string;
+	/** The rule that decided, when a rule did. */
+	ruleId?: string;
+	/** Short label for the UI: `read-only`, `write inside the repo`, `remote write`, … */
+	scopes: string[];
+}
+
+export interface Context {
+	cwd: string;
+	tier: Tier;
+	/** No human to ask. `ask` becomes `block`. */
+	headless: boolean;
+	/** Skip `ask` decisions (--yes). Never skips `block`. */
+	skipApprovals: boolean;
+}
+
+const READ_TOOLS = new Set(["read", "grep", "find", "ls", "glob", "search"]);
+const WRITE_TOOLS = new Set(["write", "edit", "multiedit", "patch"]);
+
+/** Tools that only change state through other tools, so the calls themselves are allowed. */
+const TRANSPARENT_TOOLS = new Set(["script", "wait_for_script", "task", "task_output", "task_stop", "tool_search"]);
+
+/** Whether a path is inside `cwd`. Symlinks are not resolved here; the post-check reports them. */
+export function insideCwd(cwd: string, path: string): boolean {
+	if (!path || path === ".") return true;
+	const normalized = path.startsWith("/") ? path : `${cwd.replace(/\/$/, "")}/${path}`;
+	const base = cwd.replace(/\/$/, "");
+	const parts = normalized.split("/");
+	const resolved: string[] = [];
+	for (const part of parts) {
+		if (part === "" || part === ".") continue;
+		if (part === "..") {
+			resolved.pop();
+			continue;
+		}
+		resolved.push(part);
+	}
+	return `/${resolved.join("/")}`.startsWith(`${base}/`) || `/${resolved.join("/")}` === base;
+}
+
+/** Whether every segment of a command is read-only (read commands plus neutral filters). */
+export function isReadOnlyCommand(command: string): boolean {
+	const segments = parseSegments(command);
+	if (!segments || segments.length === 0) return false;
+	return segments.every(
+		(tokens) =>
+			READ_ONLY_PREFIXES.some((prefix) => matchesPrefix(tokens, prefix)) ||
+			FILTER_PREFIXES.some((prefix) => matchesPrefix(tokens, prefix)),
+	);
+}
+
+function matchRule(command: string, rules: readonly BuiltinRule[]): BuiltinRule | undefined {
+	// Ask and block rules may match extracted inner segments, so the whole line is fair game.
+	for (const rule of rules) {
+		if (!rule.match.prefix && !rule.match.anyToken && !rule.match.regex) continue;
+		if (ruleMatches(rule, command)) return rule;
+	}
+	return undefined;
+}
+
+/** The tier default for a call no rule claimed. */
+function tierDefault(call: Call, context: Context): Verdict {
+	const { tier } = context;
+	const readOnly = typeof call.input.command === "string" ? isReadOnlyCommand(call.input.command) : false;
+
+	if (READ_TOOLS.has(call.tool)) {
+		return { decision: "allow", reason: "Reading.", scopes: ["read"] };
+	}
+	if (TRANSPARENT_TOOLS.has(call.tool)) {
+		return { decision: "allow", reason: "Calls it makes are checked one by one.", scopes: ["delegates"] };
+	}
+	if (WRITE_TOOLS.has(call.tool)) {
+		const path = String(call.input.path ?? call.input.file_path ?? "");
+		const inside = insideCwd(context.cwd, path);
+		if (tier === "none") {
+			return { decision: "ask", reason: "The `none` tier does not write.", scopes: ["write"] };
+		}
+		if (!inside) {
+			return { decision: "ask", reason: "That path is outside the project.", scopes: ["write", "outside-repo"] };
+		}
+		return { decision: "allow", reason: "Writing inside the project.", scopes: ["write"] };
+	}
+	if (call.tool === "bash") {
+		const command = String(call.input.command ?? "");
+		if (readOnly) return { decision: "allow", reason: "Read-only command.", scopes: ["read-only"] };
+		switch (tier) {
+			case "none":
+				return { decision: "ask", reason: "The `none` tier does not run commands.", scopes: ["shell"] };
+			case "low":
+				return { decision: "ask", reason: "The `low` tier asks before commands that change anything.", scopes: ["shell"] };
+			case "medium":
+			case "high":
+				return { decision: "allow", reason: "Shell command at the current tier.", scopes: ["shell"] };
+		}
+	}
+	// Unknown tool: allowed at medium and above, asked below, never silently at `none`.
+	if (tier === "none" || tier === "low") {
+		return { decision: "ask", reason: `The \`${tier}\` tier asks before \`${call.tool}\`.`, scopes: [call.tool] };
+	}
+	return { decision: "allow", reason: "Allowed at the current tier.", scopes: [call.tool] };
+}
+
+/** Decide one tool call. */
+export function decide(call: Call, context: Context, rules: readonly BuiltinRule[] = BUILTIN_RULES): Verdict {
+	const command = typeof call.input.command === "string" ? call.input.command : undefined;
+	const verdict = command
+		? (() => {
+				const rule = matchRule(command, rules);
+				return rule
+					? { decision: rule.decision, reason: rule.reason, ruleId: rule.id, scopes: [rule.id.replace(/^builtin\//, "")] }
+					: tierDefault(call, context);
+			})()
+		: tierDefault(call, context);
+
+	// Belt and braces: a secret path is a secret path whatever the tool.
+	const pathText = [call.input.path, call.input.file_path, call.input.command]
+		.filter((value): value is string => typeof value === "string")
+		.join(" ");
+	if (verdict.decision !== "block" && /\B\.env(\.[\w-]+)?\b|\bid_(rsa|ed25519)\b|\b\.ssh\/|\bcredentials\.json\b|\B\.pem\b/.test(pathText)) {
+		const rule = rules.find((candidate) => candidate.id === "builtin/secret-paths");
+		return { decision: "block", reason: rule?.reason ?? "That path holds credentials.", ruleId: "builtin/secret-paths", scopes: ["secret"] };
+	}
+
+	return enforce(context, verdict);
+}
+
+/**
+ * Turn an `ask` that nobody can answer into a deny. `skipApprovals` denies rather than allows: a
+ * flag that means "do not ask me" must never mean "do whatever you like".
+ */
+export function enforce(context: Context, verdict: Verdict): Verdict {
+	if (verdict.decision !== "ask") return verdict;
+	if (!context.headless && !context.skipApprovals) return verdict;
+	return {
+		decision: "block",
+		reason: context.headless
+			? `${verdict.reason} No human is here to approve it, so it was denied.`
+			: `${verdict.reason} Approvals were skipped, so it was denied.`,
+		ruleId: verdict.ruleId,
+		scopes: verdict.scopes,
+	};
+}
+
+/**
+ * Decide with the project's permissions files in front of the builtin floor.
+ *
+ * A policy rule wins over the tier default because it is more specific; the builtin floor is still
+ * applied to the result, because a `block` there is not overridable.
+ */
+export function decideWithPolicy(
+	call: Call,
+	context: Context,
+	policy: readonly PolicyRule[],
+	builtin: readonly BuiltinRule[] = BUILTIN_RULES,
+): Verdict & { source?: string } {
+	const command = typeof call.input.command === "string" ? call.input.command : undefined;
+	if (command) {
+		const resolution = resolveCommand(command, policy);
+		if (resolution?.rule) {
+			const verdict: Verdict = {
+				decision: resolution.decision,
+				reason: resolution.rule.reason,
+				ruleId: resolution.rule.id,
+				scopes: [resolution.rule.id.startsWith("builtin/") ? resolution.rule.id.slice("builtin/".length) : resolution.rule.id],
+			};
+			const floored = decide(call, { ...context, tier: context.tier === "none" ? "high" : context.tier }, builtin);
+			const final = floored.decision === "block" ? floored : enforce(context, verdict);
+			return { ...final, source: resolution.rule.source };
+		}
+	}
+	return decide(call, context, builtin);
+}
diff --git a/packages/coding-agent/src/extensions/tasks/child.ts b/packages/coding-agent/src/extensions/tasks/child.ts
new file mode 100644
index 0000000..d78ea58
--- /dev/null
+++ b/packages/coding-agent/src/extensions/tasks/child.ts
@@ -0,0 +1,252 @@
+/**
+ * Running a child agent.
+ *
+ * The child is a separate `reef -p` process, not a second Agent in this one, for three reasons:
+ * its context, its tool set, and its failure mode are all separate. A child that hangs or crashes
+ * cannot take the parent with it, and killing it is killing a process.
+ *
+ * The child is asked for JSON events (`--mode json`), so the parent gets the child's final text and
+ * its exact usage — cost attribution is a measurement, not an estimate.
+ */
+
+import { spawn } from "node:child_process";
+import { join } from "node:path";
+import type { AgentDefinition } from "./definitions.ts";
+import { toolsFor } from "./definitions.ts";
+
+/** A child's final message is capped here. A subagent that needs more than this is a badly scoped task. */
+export const MAX_RETURN_TOKENS = 2000;
+const MAX_RETURN_CHARS = MAX_RETURN_TOKENS * 4;
+
+export interface TaskSpec {
+	/** One paragraph, outcome-shaped. */
+	prompt: string;
+	/** Facts the child needs, curated by the parent. */
+	context?: string;
+	constraints?: string[];
+	done_when?: string[];
+	return_format?: "summary" | "patch" | "findings" | "json";
+	/** Overrides the definition's model. */
+	model?: string;
+}
+
+export interface TaskUsage {
+	input: number;
+	output: number;
+	cacheRead: number;
+	cacheWrite: number;
+	cost: number;
+}
+
+export interface TaskResult {
+	status: "done" | "failed" | "killed";
+	/** The child's final message, capped. */
+	message: string;
+	turns: number;
+	usage: TaskUsage;
+	durationMs: number;
+	exitCode?: number;
+	/** The full event stream, for `.reef/runs/` and for debugging. */
+	events: number;
+}
+
+export interface RunChildOptions {
+	definition: AgentDefinition;
+	spec: TaskSpec;
+	cwd: string;
+	signal?: AbortSignal;
+	/** The launcher the parent was started with. */
+	launcher: { command: string; args: string[] };
+	onProgress?: (line: string) => void;
+}
+
+/**
+ * The child's system prompt: the definition body, then the contract. Short by design — the child
+ * does not get the parent's rules, tools, or context files.
+ */
+export function buildChildPrompt(definition: AgentDefinition, spec: TaskSpec): string {
+	const sections: string[] = [definition.body.trim(), "", "<delegation>"];
+	sections.push(`You are a subagent named \`${definition.name}\`. You report to one caller and cannot ask it questions.`);
+	sections.push("You receive a specification, not a conversation. Everything you need is below.");
+	sections.push(`Return exactly one message.${spec.return_format === "json" ? " It must be valid JSON." : ""}`);
+	sections.push(`Keep it under ${MAX_RETURN_TOKENS} tokens. No preamble, no restating the task.`);
+	sections.push("</delegation>", "", "<specification>", spec.prompt.trim());
+	if (spec.context) sections.push("", "<context>", spec.context.trim(), "</context>");
+	if (spec.constraints?.length) sections.push("", "Constraints:", ...spec.constraints.map((item) => `- ${item}`));
+	if (spec.done_when?.length) sections.push("", "Done when:", ...spec.done_when.map((item) => `- ${item}`));
+	if (spec.return_format) sections.push("", `Return format: ${spec.return_format}`);
+	sections.push("</specification>");
+	return sections.join("\n");
+}
+
+/** Cap the return without cutting a word in half. */
+export function capReturn(text: string): string {
+	const trimmed = text.trim();
+	if (trimmed.length <= MAX_RETURN_CHARS) return trimmed;
+	return `${trimmed.slice(0, MAX_RETURN_CHARS)}\n\n[truncated at ${MAX_RETURN_TOKENS} tokens]`;
+}
+
+function emptyUsage(): TaskUsage {
+	return { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, cost: 0 };
+}
+
+/** Pull the final assistant text and the summed usage out of the child's event stream. */
+export function summarizeEvents(lines: readonly string[]): { message: string; turns: number; usage: TaskUsage } {
+	const usage = emptyUsage();
+	let message = "";
+	let turns = 0;
+	for (const line of lines) {
+		const trimmed = line.trim();
+		if (!trimmed.startsWith("{")) continue;
+		let event: {
+			type?: string;
+			message?: { role?: string; content?: { type?: string; text?: string }[]; usage?: Partial<TaskUsage> };
+		};
+		try {
+			event = JSON.parse(trimmed);
+		} catch {
+			continue;
+		}
+		if (event.type === "turn_start") turns += 1;
+		if (event.type !== "message_end" || event.message?.role !== "assistant") continue;
+		const text = (event.message.content ?? [])
+			.filter((part) => part.type === "text" && typeof part.text === "string")
+			.map((part) => part.text)
+			.join("");
+		if (text.trim()) message = text;
+		const reported = event.message.usage as Record<string, unknown> | undefined;
+		if (reported) {
+			const num = (key: string): number => {
+				const value = reported[key];
+				const parsed = typeof value === "number" ? value : Number(value);
+				return Number.isFinite(parsed) ? parsed : 0;
+			};
+			usage.input += num("input");
+			usage.output += num("output");
+			usage.cacheRead += num("cacheRead");
+			usage.cacheWrite += num("cacheWrite");
+			// `cost` is an object (`{input, output, cacheRead, cacheWrite, total}`), not a scalar.
+			const cost = reported.cost;
+			if (typeof cost === "number") usage.cost += Number.isFinite(cost) ? cost : 0;
+			else if (cost && typeof cost === "object") {
+				const total = (cost as Record<string, unknown>).total;
+				const parsed = typeof total === "number" ? total : Number(total);
+				if (Number.isFinite(parsed)) usage.cost += parsed;
+			}
+		}
+	}
+	return { message: capReturn(message), turns, usage };
+}
+
+/** Run a child agent to completion. */
+export async function runChild(options: RunChildOptions): Promise<TaskResult> {
+	const startedAt = Date.now();
+	const prompt = buildChildPrompt(options.definition, options.spec);
+	const tools = toolsFor(options.definition);
+	const model = options.spec.model ?? (options.definition.model === "inherit" ? undefined : options.definition.model);
+
+	const args = [
+		...options.launcher.args,
+		"-p",
+		options.spec.prompt,
+		"--mode",
+		"json",
+		"--no-session",
+		"--system-prompt",
+		prompt,
+		// The child gets its definition's tools directly: there is no parent transcript to protect.
+		"--tools",
+		tools.join(","),
+	];
+	if (model) args.push("--model", model);
+
+	const child = spawn(options.launcher.command, args, {
+		cwd: options.cwd,
+		env: { ...process.env, REEF_SUBAGENT: "1" },
+		stdio: ["ignore", "pipe", "pipe"],
+	});
+	const lines: string[] = [];
+	let stderrText = "";
+
+	const abort = () => child.kill("SIGTERM");
+	options.signal?.addEventListener("abort", abort, { once: true });
+
+	await new Promise<void>((resolve) => {
+		let buffered = "";
+		child.stdout?.on("data", (chunk: Buffer) => {
+			buffered += chunk.toString("utf8");
+			const parts = buffered.split("\n");
+			buffered = parts.pop() ?? "";
+			for (const part of parts) {
+				lines.push(part);
+				if (part.includes('"type":"turn_start"')) options.onProgress?.(`turn ${lines.length}`);
+			}
+		});
+		child.stderr?.on("data", (chunk: Buffer) => {
+			stderrText += chunk.toString("utf8");
+		});
+		child.on("error", (error) => {
+			stderrText += `\n${error.message}`;
+			resolve();
+		});
+		child.on("close", () => resolve());
+	});
+
+	options.signal?.removeEventListener("abort", abort);
+	const exitCode = child.exitCode ?? undefined;
+	const summary = summarizeEvents(lines);
+	const killed = options.signal?.aborted === true;
+	const failed = !killed && exitCode !== 0 && summary.message === "";
+
+	return {
+		status: killed ? "killed" : failed ? "failed" : "done",
+		message:
+			summary.message ||
+			(failed ? `The subagent failed (exit ${exitCode ?? "?"}): ${stderrText.trim().slice(0, 400)}` : "(no message)"),
+		turns: summary.turns,
+		usage: summary.usage,
+		durationMs: Date.now() - startedAt,
+		exitCode,
+		events: lines.length,
+	};
+}
+
+/**
+ * The family of a model id, which for every provider we have seen is the first segment:
+ * `claude-haiku-5-5` → `claude`, `deepseek-v4-pro` → `deepseek`, `gpt-6-luna` → `gpt`.
+ *
+ * Used only to give a reviewer a different family from the driver, so two models do not share the
+ * same blind spot. It is not a ranking and nothing else reads it.
+ */
+export function modelFamily(modelId: string): string {
+	return modelId.split(/[-/]/)[0]?.toLowerCase() ?? modelId;
+}
+
+export interface ModelCandidate {
+	provider: string;
+	id: string;
+}
+
+/**
+ * Pick a model from a different family than the one named. `undefined` when every available model
+ * shares the family, which is the honest answer: independence cannot be manufactured from one vendor.
+ */
+export function independentModel(driverId: string, available: readonly ModelCandidate[]): ModelCandidate | undefined {
+	const family = modelFamily(driverId);
+	const candidates = available.filter((model) => modelFamily(model.id) !== family);
+	if (candidates.length === 0) return undefined;
+	// Prefer a full model over a small or free one, then a stable id so repeated runs agree.
+	const rank = (id: string) => (/free|flash|mini|small|haiku/i.test(id) ? 1 : 0);
+	return [...candidates].sort((a, b) => rank(a.id) - rank(b.id) || a.id.localeCompare(b.id))[0];
+}
+
+/** Where the parent's launcher lives, so the child starts the same program. */
+export function resolveLauncher(): { command: string; args: string[] } {
+	const entry = process.argv[1];
+	return { command: process.execPath, args: entry ? [entry] : [] };
+}
+
+/** `.reef/runs/tasks/<id>.jsonl`, relative to the project. */
+export function runsPath(cwd: string, id: string): string {
+	return join(cwd, ".reef", "runs", "tasks", `${id}.jsonl`);
+}
diff --git a/packages/coding-agent/src/extensions/tasks/definitions.ts b/packages/coding-agent/src/extensions/tasks/definitions.ts
new file mode 100644
index 0000000..024971b
--- /dev/null
+++ b/packages/coding-agent/src/extensions/tasks/definitions.ts
@@ -0,0 +1,242 @@
+/**
+ * Subagent definitions: `.reef/agents/<name>.md` and `~/.reef/agents/<name>.md`.
+ *
+ * A definition is a prompt and a tool policy. It is not a session, not a fork, and it inherits
+ * nothing: the child gets the definition body, a short `<delegation>` section, and the task
+ * specification the parent writes. That is the whole point of delegation — the parent curates, the
+ * child works, and the parent's cache stays warm.
+ */
+
+import { readdirSync, readFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { basename, join } from "node:path";
+
+/** The tool categories a definition may ask for. */
+export type ToolPolicyKind = "read-only" | "edit" | "execute" | "all";
+
+/** Tools each category grants. A definition may also name tools explicitly. */
+export const TOOL_SETS: Record<ToolPolicyKind, string[]> = {
+	"read-only": ["read", "grep", "find", "ls"],
+	edit: ["read", "grep", "find", "ls", "edit", "write"],
+	execute: ["read", "grep", "find", "ls", "edit", "write", "bash"],
+	all: ["read", "grep", "find", "ls", "edit", "write", "bash"],
+};
+
+/** Tools a child never gets, whatever the definition says. */
+export const FORBIDDEN_CHILD_TOOLS = new Set(["task", "task_output", "task_stop", "wait_for_script"]);
+
+export interface AgentDefinition {
+	name: string;
+	description: string;
+	/** `inherit`, `different` (another family than the driver), a tier, or an explicit id. */
+	model: string;
+	reasoning?: string;
+	/** A category, an explicit list, or both. */
+	tools: { kind: ToolPolicyKind; explicit: string[] };
+	/** The prompt. Everything after the frontmatter. */
+	body: string;
+	/** Where it came from, for `/agents`. */
+	source: string;
+}
+
+export interface DefinitionProblem {
+	source: string;
+	message: string;
+}
+
+const NAME_PATTERN = /^[a-z0-9][a-z0-9-_]*$/;
+
+/** Split `---` frontmatter from the body. No YAML library: the schema is flat on purpose. */
+export function splitFrontmatter(text: string): { fields: Record<string, string>; body: string } | undefined {
+	const normalized = text.replace(/\r\n/g, "\n");
+	if (!normalized.startsWith("---")) return undefined;
+	const end = normalized.indexOf("\n---", 3);
+	if (end < 0) return undefined;
+	const head = normalized.slice(3, end).trim();
+	const body = normalized.slice(normalized.indexOf("\n", end + 1) + 1).trim();
+	const fields: Record<string, string> = {};
+	for (const line of head.split("\n")) {
+		const trimmed = line.trim();
+		if (!trimmed || trimmed.startsWith("#")) continue;
+		const colon = trimmed.indexOf(":");
+		if (colon < 0) continue;
+		fields[trimmed.slice(0, colon).trim()] = trimmed.slice(colon + 1).trim();
+	}
+	return { fields, body };
+}
+
+function parseList(value: string): string[] {
+	const inner = value.trim();
+	if (inner.startsWith("[") && inner.endsWith("]")) {
+		return inner
+			.slice(1, -1)
+			.split(",")
+			.map((item) => item.trim().replace(/^["']|["']$/g, ""))
+			.filter(Boolean);
+	}
+	return inner
+		.split(",")
+		.map((item) => item.trim())
+		.filter(Boolean);
+}
+
+/** Parse and validate one definition file. Problems are returned, never thrown. */
+export function parseDefinition(text: string, source: string): { definition?: AgentDefinition; problems: DefinitionProblem[] } {
+	const problems: DefinitionProblem[] = [];
+	const split = splitFrontmatter(text);
+	if (!split) return { problems: [{ source, message: "missing `---` frontmatter block" }] };
+	const { fields, body } = split;
+
+	const name = fields.name || basename(source).replace(/\.md$/, "");
+	if (!NAME_PATTERN.test(name)) {
+		problems.push({ source, message: `name \`${name}\` must match ${NAME_PATTERN}` });
+	}
+	const description = fields.description?.trim();
+	if (!description) problems.push({ source, message: "missing `description`" });
+	if (!body) problems.push({ source, message: "the body is empty: that is the prompt" });
+
+	const known = new Set(["name", "description", "model", "reasoning", "tools", "mcp"]);
+	for (const key of Object.keys(fields)) {
+		if (!known.has(key)) problems.push({ source, message: `unknown field \`${key}\`` });
+	}
+
+	const rawTools = fields.tools?.trim() ?? "read-only";
+	const categories: ToolPolicyKind[] = ["read-only", "edit", "execute", "all"];
+	let kind: ToolPolicyKind = "read-only";
+	let explicit: string[] = [];
+	if (categories.includes(rawTools as ToolPolicyKind)) {
+		kind = rawTools as ToolPolicyKind;
+	} else {
+		explicit = parseList(rawTools);
+		kind = "read-only";
+		if (explicit.length === 0) problems.push({ source, message: `\`tools\` must be a category or a list of tool names` });
+	}
+
+	const model = fields.model?.trim() || "inherit";
+	const named = model === "inherit" || model === "different" || ["light", "medium", "heavy"].includes(model);
+	if (!named && !model.includes("/") && !model.includes("-")) {
+		problems.push({
+			source,
+			message: `\`model\` must be inherit, different, light|medium|heavy, or a model id, not \`${model}\``,
+		});
+	}
+
+	if (problems.length > 0) return { problems };
+	return {
+		definition: {
+			name,
+			description: description ?? "",
+			model,
+			reasoning: fields.reasoning?.trim() || undefined,
+			tools: { kind, explicit },
+			body,
+			source,
+		},
+		problems,
+	};
+}
+
+/** The tool names a definition grants, minus anything a child may not have. */
+export function toolsFor(definition: AgentDefinition): string[] {
+	const granted = definition.tools.explicit.length > 0 ? definition.tools.explicit : TOOL_SETS[definition.tools.kind];
+	return [...new Set(granted)].filter((name) => !FORBIDDEN_CHILD_TOOLS.has(name));
+}
+
+export interface LoadedDefinitions {
+	definitions: AgentDefinition[];
+	problems: DefinitionProblem[];
+	/** Files that were read. */
+	sources: string[];
+}
+
+function listMarkdown(dir: string): string[] {
+	try {
+		return readdirSync(dir)
+			.filter((name) => name.endsWith(".md"))
+			.map((name) => join(dir, name));
+	} catch {
+		return [];
+	}
+}
+
+/**
+ * Load personal definitions first, then project ones. A project definition with the same name
+ * replaces the personal one: the repository's rules win inside the repository.
+ */
+export function loadDefinitions(cwd: string, agentDir = join(homedir(), ".reef", "agent")): LoadedDefinitions {
+	const byName = new Map<string, AgentDefinition>();
+	const problems: DefinitionProblem[] = [];
+	const sources: string[] = [];
+
+	const read = (path: string) => {
+		try {
+			return readFileSync(path, "utf8");
+		} catch {
+			return undefined;
+		}
+	};
+
+	for (const dir of [join(agentDir, "agents"), join(cwd, ".reef", "agents")]) {
+		for (const path of listMarkdown(dir)) {
+			const text = read(path);
+			if (text === undefined) continue;
+			sources.push(path);
+			const result = parseDefinition(text, path);
+			problems.push(...result.problems);
+			if (result.definition) byName.set(result.definition.name, result.definition);
+		}
+	}
+
+	return { definitions: [...byName.values()].sort((a, b) => a.name.localeCompare(b.name)), problems, sources };
+}
+
+/** The built-in agents, used when a project defines none. */
+export const BUILTIN_AGENTS: AgentDefinition[] = [
+	{
+		name: "explorer",
+		description: "Finds where something lives and reports the shape of it, reading only",
+		model: "inherit",
+		tools: { kind: "read-only", explicit: [] },
+		source: "builtin",
+		body: `You are an explorer. You answer one question about a codebase by reading it.
+
+Rules:
+- Search before you read, and read before you conclude. Name files and lines.
+- Report what exists, not what should exist. No recommendations unless asked.
+- If the question is ambiguous, answer the most useful reading of it and say which you chose.
+- Finish in one message: findings, ordered by relevance, each with a path.`,
+	},
+	{
+		name: "reviewer",
+		description: "Reviews a diff for correctness, security, and migration risk",
+		// A reviewer that shares the driver's family shares its blind spot. Reef picks another family
+		// when one is configured, and says so when there is not.
+		model: "different",
+		tools: { kind: "read-only", explicit: [] },
+		source: "builtin",
+		body: `You are a senior reviewer. You are given a diff and the intent behind it.
+
+Report, in order, and only what you can defend:
+1. Correctness risks, with file:line
+2. Security issues (injection, authz, secrets, unsafe deserialisation)
+3. Migration and data risks
+4. Missing tests
+
+Do not propose rewrites. Do not edit files. If the diff is fine, say so in one line.`,
+	},
+	{
+		name: "scout",
+		description: "Runs commands to find out what is true on this machine: versions, failures, timings",
+		model: "inherit",
+		tools: { kind: "execute", explicit: [] },
+		source: "builtin",
+		body: `You are a scout. You answer questions about the state of this machine or this build by running
+commands, not by guessing.
+
+Rules:
+- One command at a time when the next depends on the last; batch them when it does not.
+- Quote the actual output that supports your answer, trimmed to the relevant lines.
+- Never claim a version, a count, or a timing you did not read from output.
+- Keep the final message short: the answer, then the evidence.`,
+	},
+];
